# RESQ-GRID Environment Configuration

PORT=5000
NODE_ENV=development
JWT_SECRET=resqgrid_secret_jwt_key_hackathon_2026_demo

# MongoDB connection string (Optional: if mongod is running locally or on Atlas)
# If local MongoDB is not running, RESQ-GRID automatically uses its embedded JSON engine!
MONGODB_URI=mongodb://localhost:27017/resqgrid

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
